{
  "id": "com.dishylink.app",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "dishy-gtk",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--device=dri",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--socket=session-bus",
    "--talk-name=org.freedesktop.Notifications",
    "--filesystem=xdg-config/autostart:create",
    "--filesystem=xdg-data/gnome-shell/extensions:create",
    "--talk-name=org.gnome.Shell.Extensions"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/man",
    "/share/gtk-doc",
    "/share/vala"
  ],
  "modules": [
    {
      "name": "libsecret",
      "buildsystem": "meson",
      "config-opts": [
        "-Dmanpage=false",
        "-Dvapi=false",
        "-Dgtk_doc=false",
        "-Dintrospection=false",
        "-Dbash_completion=disabled",
        "-Dcrypto=disabled",
        "-Dpam=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/libsecret/0.21/libsecret-0.21.7.tar.xz",
          "sha256": "6b452e4750590a2b5617adc40026f28d2f4903de15f1250e1d1c40bfd68ed55e"
        }
      ]
    },
    {
      "name": "dishylink",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/dishylink/cargo",
          "CARGO_NET_OFFLINE": "true"
        }
      },
      "build-commands": [
        "cargo --offline build --release --locked -p dishy-gtk",
        "install -Dm755 target/release/dishy-gtk /app/bin/dishy-gtk",
        "install -Dm644 packaging/linux/com.dishylink.app.desktop /app/share/applications/com.dishylink.app.desktop",
        "install -Dm644 packaging/linux/com.dishylink.app.metainfo.xml /app/share/metainfo/com.dishylink.app.metainfo.xml",
        "install -Dm644 packaging/linux/icons/com.dishylink.app.svg /app/share/icons/hicolor/scalable/apps/com.dishylink.app.svg",
        "install -Dm644 packaging/linux/icons/com.dishylink.app-512.png /app/share/icons/hicolor/512x512/apps/com.dishylink.app.png"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            "target",
            ".git",
            ".flatpak-builder",
            ".starlink-cookie",
            ".router-address",
            ".claude",
            "CLAUDE.local.md",
            "HANDOFF.md"
          ]
        },
        "cargo-sources.json"
      ]
    }
  ]
}
